{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/experiment-manifest.schema.json",
  "title": "ExperimentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","experiment_id","research_question","hypotheses","model_ids","fixture_ids","representation_sites","metrics","seeds","thresholds","data_classification","created_at_utc"],
  "properties": {
    "schema_version": {"type":"string","const":"1.0.0"},
    "experiment_id": {"type":"string","minLength":1},
    "research_question": {"type":"string","minLength":1},
    "hypotheses": {"type":"array","minItems":1,"items":{"type":"object","required":["id","claim"],"properties":{"id":{"type":"string"},"claim":{"type":"string"},"null":{"type":["string","null"]}},"additionalProperties":false}},
    "model_ids": {"type":"array","minItems":1,"items":{"type":"string"}},
    "fixture_ids": {"type":"array","minItems":1,"items":{"type":"string"}},
    "transform_ids": {"type":"array","items":{"type":"string"},"default":[]},
    "representation_sites": {"type":"array","minItems":1,"items":{"type":"string"}},
    "metrics": {"type":"array","minItems":1,"items":{"type":"string"}},
    "seeds": {"type":"array","minItems":1,"items":{"type":"integer"}},
    "thresholds": {"type":"object","minProperties":1,"additionalProperties":{"type":["number","integer","string","boolean"]}},
    "partitions": {"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}},
    "environment_requirements": {"type":"object","additionalProperties":true},
    "data_classification": {"enum":["PUBLIC_REPRODUCIBLE","RESEARCH_INTERNAL","SENSITIVE"]},
    "authorization_ref": {"type":["string","null"]},
    "created_at_utc": {"type":"string","format":"date-time"}
  }
}
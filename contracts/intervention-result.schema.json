{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/intervention-result.schema.json",
  "title": "InterventionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","intervention_id","manifest_id","operation","target_site","baseline_refs","control_refs","outcome_metric_ids","status","created_at_utc"],
  "properties": {
    "schema_version": {"type":"string","const":"1.0.0"},
    "intervention_id": {"type":"string","minLength":1},
    "manifest_id": {"type":"string","minLength":1},
    "operation": {"enum":["PATCH","ABLATE","STEER","INJECT","OTHER"]},
    "source_site": {"type":["string","null"]},
    "target_site": {"type":"string","minLength":1},
    "configuration": {"type":"object","additionalProperties":true},
    "baseline_refs": {"type":"array","minItems":1,"items":{"type":"string"}},
    "control_refs": {"type":"array","minItems":1,"items":{"type":"string"}},
    "outcome_metric_ids": {"type":"array","minItems":1,"items":{"type":"string"}},
    "effect_estimate": {"type":["number","object","null"]},
    "uncertainty": {"type":["number","object","null"]},
    "status": {"enum":["MEASURED","FAILED","INCONCLUSIVE","NOT_COMPUTABLE"]},
    "limitations": {"type":"array","items":{"type":"string"},"default":[]},
    "created_at_utc": {"type":"string","format":"date-time"}
  }
}
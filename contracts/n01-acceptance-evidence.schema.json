{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/n01-acceptance-evidence.schema.json",
  "title": "N01AcceptanceEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "experiment_id", "model", "fixture", "tolerance", "site_results", "gate_decisions", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "experiment_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "tokenizer_revision", "weights_sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "tokenizer_revision": {"type": ["string", "null"]},
        "weights_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "seed"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"}
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cosine_floor", "euclidean_ceiling"],
      "properties": {
        "cosine_floor": {"type": "number", "minimum": -1, "maximum": 1},
        "euclidean_ceiling": {"type": "number", "minimum": 0}
      }
    },
    "site_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "observations", "failures", "comparisons", "decision"],
        "properties": {
          "site": {"type": "string", "minLength": 1},
          "observations": {"type": "array", "items": {"type": "object"}},
          "failures": {"type": "array", "items": {"type": "object"}},
          "comparisons": {"type": "array", "items": {"type": "object"}},
          "decision": {"enum": ["ACCEPT", "REJECT"]}
        }
      }
    },
    "gate_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AC-N0", "AC-N1"],
      "properties": {
        "AC-N0": {"enum": ["ACCEPT", "REJECT", "NOT_COMPUTABLE"]},
        "AC-N1": {"enum": ["ACCEPT", "REJECT", "NOT_COMPUTABLE"]}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
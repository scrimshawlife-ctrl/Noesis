{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostate.dev/schemas/epistemic-interchange-object.schema.json",
  "title": "EpistemicInterchangeObject",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","object_id","proposition_id","epistemic_status","evidence_refs","provenance","authority"],
  "properties": {
    "schema_version": {"const":"0.1.0"},
    "object_id": {"type":"string","minLength":1},
    "proposition_id": {"type":"string","minLength":1},
    "epistemic_status": {"enum":["OBSERVED","INTERPRETED","CALIBRATED","SETTLED","NOT_COMPUTABLE"]},
    "evidence_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "observation_refs": {"type":"array","items":{"type":"string","minLength":1}},
    "assertions": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["assertion_id","class","component","evidence_refs"],"properties":{"assertion_id":{"type":"string","minLength":1},"class":{"enum":["INTERPRETATION","CALIBRATION","SETTLEMENT","LIMITATION"]},"component":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"limitations":{"type":"array","items":{"type":"string"}}}}},
    "transformations": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["transform_id","source_hash","output_hash"],"properties":{"transform_id":{"type":"string","minLength":1},"source_hash":{"type":"string","minLength":1},"output_hash":{"type":"string","minLength":1},"declared_invariants":{"type":"array","items":{"type":"string"}},"expected_changed_attributes":{"type":"array","items":{"type":"string"}}}}},
    "controls": {"type":"array","items":{"type":"string"}},
    "contradictions": {"type":"array","items":{"type":"string"}},
    "uncertainty": {"type":["object","null"],"additionalProperties":true},
    "provenance": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["event_id","component","operation","utc_time","output_hash","authority"],"properties":{"event_id":{"type":"string","minLength":1},"component":{"type":"string","minLength":1},"operation":{"type":"string","minLength":1},"utc_time":{"type":"string","format":"date-time"},"input_hashes":{"type":"array","items":{"type":"string"}},"output_hash":{"type":"string","minLength":1},"revision":{"type":"string"},"authority":{"type":"string","minLength":1}}}},
    "authority": {"type":"object","additionalProperties":false,"required":["scope","effect"],"properties":{"scope":{"type":"string","minLength":1},"effect":{"enum":["ADVISORY_ONLY","RESEARCH_ONLY","GOVERNANCE_REVIEW"]}}},
    "supersedes": {"type":"array","items":{"type":"string","minLength":1}}
  }
}

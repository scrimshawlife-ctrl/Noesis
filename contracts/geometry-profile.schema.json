{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.invalid/contracts/geometry-profile.schema.json",
  "title": "GeometryProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "experiment_id", "candidate_spaces", "partitions", "primary_metrics", "selection_rule", "nulls", "failure_policy", "created_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "candidate_spaces": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": ["family"],
        "properties": {"family": {"const": "EUCLIDEAN"}}
      },
      "minContains": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "family", "dimension", "metric", "fit_config", "complexity_cost"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "family": {"enum": ["EUCLIDEAN", "HYPERBOLIC", "SPHERICAL", "PRODUCT_MANIFOLD", "TOPOLOGICAL"]},
          "curvature": {"type": ["number", "null"]},
          "dimension": {"type": "integer", "minimum": 1},
          "metric": {"type": "string", "minLength": 1},
          "fit_config": {"type": "object"},
          "complexity_cost": {"type": "number", "minimum": 0}
        }
      }
    },
    "partitions": {
      "type": "object", "additionalProperties": false,
      "required": ["discovery_hash", "selection_hash", "confirmation_hash", "control_hash"],
      "properties": {
        "discovery_hash": {"$ref": "#/$defs/sha256"},
        "selection_hash": {"$ref": "#/$defs/sha256"},
        "confirmation_hash": {"$ref": "#/$defs/sha256"},
        "control_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "primary_metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "selection_rule": {"type": "object", "minProperties": 1},
    "nulls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failure_policy": {"enum": ["FAIL_CLOSED", "NOT_COMPUTABLE"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

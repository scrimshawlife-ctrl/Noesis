{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/alignment-map.schema.json",
  "title": "AlignmentMap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","alignment_id","source_space","target_space","algorithm","train_partition_hash","validation_partition_hash","test_partition_hash","artifact_ref","artifact_hash","status","created_at_utc"],
  "properties": {
    "schema_version": {"type":"string","const":"1.0.0"},
    "alignment_id": {"type":"string","minLength":1},
    "source_space": {"type":"string","minLength":1},
    "target_space": {"type":"string","minLength":1},
    "algorithm": {"type":"string","minLength":1},
    "hyperparameters": {"type":"object","additionalProperties":true},
    "train_partition_hash": {"type":"string","minLength":1},
    "validation_partition_hash": {"type":"string","minLength":1},
    "test_partition_hash": {"type":"string","minLength":1},
    "artifact_ref": {"type":"string","minLength":1},
    "artifact_hash": {"type":"string","minLength":1},
    "validation_metric_ids": {"type":"array","items":{"type":"string"}},
    "test_metric_ids": {"type":"array","items":{"type":"string"}},
    "null_metric_ids": {"type":"array","items":{"type":"string"}},
    "shift_metric_ids": {"type":"array","items":{"type":"string"}},
    "status": {"enum":["SUPPORTED","WEAK","REJECTED","NOT_COMPUTABLE","INVALIDATED"]},
    "limitations": {"type":"array","items":{"type":"string"},"default":[]},
    "created_at_utc": {"type":"string","format":"date-time"}
  }
}
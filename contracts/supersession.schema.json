{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/supersession.schema.json",
  "title": "Noesis SupersessionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "supersession_id", "old_object_id", "successor_ref", "reason", "actor", "created_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "supersession_id": {"type": "string", "minLength": 1},
    "old_object_id": {"type": "string", "minLength": 1},
    "successor_ref": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}

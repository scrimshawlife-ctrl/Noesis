{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/exp001-source-corpus.schema.json",
  "title": "EXP001SourceCorpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "version", "data_classification", "fixtures", "created_at_utc"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "corpus_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "data_classification": {"enum": ["PUBLIC_REPRODUCIBLE", "RESEARCH_INTERNAL", "SENSITIVE"]},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "text", "sha256", "hypothesis_tags", "partition"],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "hypothesis_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "partition": {"enum": ["discovery", "confirmation", "control"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "operator_ref": {"type": ["string", "null"]}
  }
}